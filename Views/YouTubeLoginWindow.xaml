<Window x:Class="ExportX.Views.YouTubeLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="🔑 LOGOWANIE DO YOUTUBE / GOOGLE"
        Height="720" Width="920"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource NotebookGridPatternBrush}"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResizeWithGrip">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Red margin stripe decoration on left -->
        <Border Grid.RowSpan="3" 
                Width="3" 
                HorizontalAlignment="Left" 
                Background="{StaticResource BrushNotebookRedMargin}" 
                Margin="-8,-16,0,-16" />

        <!-- Header Card -->
        <Border Grid.Row="0" Style="{StaticResource BrutalistCard}" Margin="0,0,0,12" Background="{StaticResource BrushNeonYellow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="🔑" FontSize="26" Margin="0,0,10,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="LOGOWANIE DO YOUTUBE / GOOGLE" 
                               FontFamily="Segoe UI" 
                               FontWeight="Black" 
                               FontSize="16" 
                               Foreground="{StaticResource BrushBlackBorder}" />
                    <TextBlock Text="Zaloguj się na swoje konto Google. Twoja sesja (cookies) zostanie bezpiecznie zapisana TYLKO lokalnie na Twoim dysku, odblokowując filmy +18 i playlisty prywatne." 
                               FontSize="11" 
                               FontWeight="SemiBold" 
                               Foreground="#333333" 
                               TextWrapping="Wrap" />
                </StackPanel>

                <Border Grid.Column="2" x:Name="StatusBadge" Style="{StaticResource StickyNoteTag}" Background="{StaticResource BrushNeonLime}" Padding="8,4" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusBadgeText" Text="BEZPIECZNE LOGOWANIE" FontWeight="Black" FontSize="10" Foreground="{StaticResource BrushBlackBorder}" />
                </Border>
            </Grid>
        </Border>

        <!-- WebView2 Browser Container -->
        <Border Grid.Row="1" Style="{StaticResource BrutalistCard}" Margin="0,0,0,12" Padding="2" Background="{StaticResource BrushPaperWhite}">
            <Grid>
                <wv2:WebView2 x:Name="LoginWebView" />
                <Border x:Name="LoadingOverlay" Background="#F0F6F4ED" Visibility="Visible">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="⏳ Ładowanie przeglądarki logowania..." FontWeight="Bold" FontSize="14" Foreground="{StaticResource BrushBlackBorder}" HorizontalAlignment="Center" />
                        <TextBlock Text="Proszę czekać..." FontSize="11" Foreground="#666666" Margin="0,4,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Bottom Action Bar -->
        <Border Grid.Row="2" Style="{StaticResource BrutalistCard}" Padding="10,8" Background="{StaticResource BrushPaperWhite}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="SessionInfoText" 
                               Text="Wskazówka: Po zalogowaniu się na stronie YouTube kliknij 'ZAPISZ SESJĘ I ZAMKNIJ'." 
                               FontWeight="Bold" 
                               FontSize="11" 
                               Foreground="{StaticResource BrushBlackBorder}" />
                </StackPanel>

                <Button Grid.Column="1" 
                        x:Name="DeleteSessionBtn"
                        Content="🗑️ USUŃ SESJĘ" 
                        Style="{StaticResource BrutalistButton}" 
                        Background="{StaticResource BrushNeonPink}"
                        FontSize="11"
                        Padding="12,6"
                        Margin="0,0,8,0"
                        Click="DeleteSession_Click" />

                <Button Grid.Column="2" 
                        Content="❌ ANULUJ" 
                        Style="{StaticResource BrutalistButton}" 
                        Background="{StaticResource BrushPaperWhite}"
                        FontSize="11"
                        Padding="12,6"
                        Margin="0,0,8,0"
                        Click="Cancel_Click" />

                <Button Grid.Column="3" 
                        x:Name="SaveSessionBtn"
                        Content="💾 ZAPISZ SESJĘ I ZAMKNIJ" 
                        Style="{StaticResource GreenStartButton}" 
                        FontSize="12"
                        FontWeight="Black"
                        Padding="16,6"
                        Click="SaveSession_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
