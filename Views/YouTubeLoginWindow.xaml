<Window x:Class="ExportX.Views.YouTubeLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="🔑 LOGOWANIE DO YOUTUBE / GOOGLE"
        Height="720" Width="920"
        MinHeight="550" MinWidth="750"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource NotebookGridPatternBrush}"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResizeWithGrip">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="*" />    <!-- Web Browser & Account Chooser -->
            <RowDefinition Height="Auto" /> <!-- Bottom Action Bar -->
        </Grid.RowDefinitions>

        <!-- Red margin stripe decoration on left -->
        <Border Grid.RowSpan="3" 
                Width="3" 
                HorizontalAlignment="Left" 
                Background="{StaticResource BrushNotebookRedMargin}" 
                Margin="-8,-16,0,-16" />

        <!-- ================= HEADER CARD ================= -->
        <Border Grid.Row="0" Style="{StaticResource BrutalistCard}" Margin="0,0,0,10" Background="{StaticResource BrushNeonYellow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="🔑" FontSize="26" Margin="0,0,10,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="LOGOWANIE DO YOUTUBE / GOOGLE" 
                               FontFamily="Segoe UI" 
                               FontWeight="Black" 
                               FontSize="15" 
                               Foreground="{StaticResource BrushBlackBorder}" />
                    <TextBlock Text="Wybierz swoje konto Google poniżej lub zaloguj się od zera. Po wybraniu konta aplikacja natychmiast automatycznie pobierze sesję!" 
                               FontSize="11" 
                               FontWeight="SemiBold" 
                               Foreground="#333333" 
                               TextWrapping="Wrap" />
                </StackPanel>

                <Border Grid.Column="2" x:Name="StatusBadge" Style="{StaticResource StickyNoteTag}" Background="{StaticResource BrushNeonLime}" Padding="8,4" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusBadgeText" Text="WYBIERZ KONTO PONIŻEJ" FontWeight="Black" FontSize="10" Foreground="{StaticResource BrushBlackBorder}" />
                </Border>
            </Grid>
        </Border>

        <!-- ================= MAIN WEBVIEW BROWSER ================= -->
        <Border Grid.Row="1" Style="{StaticResource BrutalistCard}" Margin="0,0,0,10" Padding="2" Background="{StaticResource BrushPaperWhite}">
            <Grid>
                <wv2:WebView2 x:Name="LoginWebView" />

                <!-- Loading / Fallback Overlay -->
                <Border x:Name="LoadingOverlay" Background="#F6F4ED" Visibility="Visible">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="500">
                        <TextBlock x:Name="OverlayTitle" Text="⏳ Ładowanie strony wyboru konta..." FontWeight="Black" FontSize="14" Foreground="{StaticResource BrushBlackBorder}" HorizontalAlignment="Center" />
                        <TextBlock x:Name="OverlaySubtitle" Text="Proszę czekać..." FontSize="11" Foreground="#666666" Margin="0,4,0,12" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />

                        <!-- Fallback panel if WebView2 runtime is missing -->
                        <StackPanel x:Name="FallbackPanel" Visibility="Collapsed">
                            <TextBlock Text="Nie udało się załadować wbudowanego okna. Możesz otworzyć stronę w przeglądarce i pobrać sesję jednym kliknięciem:" FontSize="11" FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap" TextAlignment="Center" />
                            
                            <Button Content="🌐 OTWÓRZ W PRZEGLĄDARCE" 
                                    Style="{StaticResource CyanButton}" 
                                    FontWeight="Black" 
                                    FontSize="11" 
                                    Padding="14,8" 
                                    Margin="0,0,0,8"
                                    Click="OpenInExternalBrowser_Click" />

                            <Button Content="📥 POBIERZ SESJĘ Z PRZEGLĄDARKI" 
                                    Style="{StaticResource GreenStartButton}" 
                                    FontWeight="Black" 
                                    FontSize="11" 
                                    Padding="14,8" 
                                    Click="ExtractFromExternalBrowser_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ================= BOTTOM ACTION BAR ================= -->
        <Border Grid.Row="2" Style="{StaticResource BrutalistCard}" Padding="10,8" Background="{StaticResource BrushPaperWhite}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="SessionInfoText" 
                               Text="Wskazówka: Kliknij swoje konto powyżej. Sesja zostanie automatycznie zapisana." 
                               FontWeight="Bold" 
                               FontSize="11" 
                               Foreground="{StaticResource BrushBlackBorder}" />
                </StackPanel>

                <Button Grid.Column="1" 
                        Content="🌐 OTWÓRZ W PRZEGLĄDARCE" 
                        Style="{StaticResource BrutalistButton}" 
                        Background="{StaticResource BrushPaperWhite}"
                        FontSize="11"
                        Padding="10,6"
                        Margin="0,0,6,0"
                        Click="OpenInExternalBrowser_Click" />

                <Button Grid.Column="2" 
                        x:Name="DeleteSessionBtn"
                        Content="🗑️ USUŃ SESJĘ" 
                        Style="{StaticResource BrutalistButton}" 
                        Background="{StaticResource BrushNeonPink}"
                        FontSize="11"
                        Padding="10,6"
                        Margin="0,0,6,0"
                        Click="DeleteSession_Click" />

                <Button Grid.Column="3" 
                        Content="❌ ANULUJ" 
                        Style="{StaticResource BrutalistButton}" 
                        Background="{StaticResource BrushPaperWhite}"
                        FontSize="11"
                        Padding="10,6"
                        Margin="0,0,6,0"
                        Click="Cancel_Click" />

                <Button Grid.Column="4" 
                        x:Name="ManualSaveBtn"
                        Content="💾 ZAPISZ RĘCZNIE" 
                        Style="{StaticResource GreenStartButton}" 
                        FontSize="11"
                        FontWeight="Black"
                        Padding="14,6"
                        Click="ManualSave_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
