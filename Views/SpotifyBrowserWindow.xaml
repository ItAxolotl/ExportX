<Window x:Class="ExportX.Views.SpotifyBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:ExportX.Models"
        Title="🟢 CENTRUM SPOTIFY - PRZEGLĄDARKA I WYBÓR PLAYLIST"
        Height="780" Width="1160"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource NotebookGridPatternBrush}"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResizeWithGrip">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Top Header & Account Bar -->
            <RowDefinition Height="*" />    <!-- Split View (Playlists & Tracks) -->
            <RowDefinition Height="Auto" /> <!-- Status & Global Actions -->
        </Grid.RowDefinitions>

        <!-- Red margin stripe decoration on left -->
        <Border Grid.RowSpan="3" 
                Width="3" 
                HorizontalAlignment="Left" 
                Background="{StaticResource BrushNotebookRedMargin}" 
                Margin="-8,-16,0,-16" />

        <!-- ================= ROW 0: TOP HEADER & ACCOUNT BAR ================= -->
        <Border Grid.Row="0" Style="{StaticResource BrutalistCard}" Margin="0,0,0,10" Background="{StaticResource BrushNeonLime}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="🟢" FontSize="26" Margin="0,0,10,0" VerticalAlignment="Center" />
                
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="CENTRUM SPOTIFY - PRZEGLĄDARKA PLAYLIST I UTWORÓW" 
                               FontFamily="Segoe UI" 
                               FontWeight="Black" 
                               FontSize="14" 
                               Foreground="{StaticResource BrushBlackBorder}" />
                    <TextBlock x:Name="AccountStatusText" 
                               Text="Zaloguj się do Spotify, aby przeglądać swoje prywatne playlisty, polubione utwory lub wyszukiwać dowolną muzykę." 
                               FontSize="11" 
                               FontWeight="SemiBold" 
                               Foreground="#222222" 
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- Account Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ExtractFromBrowserButton"
                            Content="⚡ POBIERZ Z PRZEGLĄDARKI" 
                            Style="{StaticResource CyanButton}" 
                            FontWeight="Black" 
                            FontSize="11" 
                            Padding="10,5" 
                            Margin="0,0,6,0" 
                            ToolTip="Pobierz zalogowane konto Spotify bezpośrednio z Brave, Chrome, Firefox, Opera lub Edge"
                            Click="ExtractFromBrowser_Click" />

                    <Button x:Name="LoginButton"
                            Content="🔑 ZALOGUJ DO SPOTIFY" 
                            Style="{StaticResource GreenStartButton}" 
                            FontWeight="Black" 
                            FontSize="11" 
                            Padding="12,5" 
                            Margin="0,0,6,0" 
                            Click="Login_Click" />

                    <Button x:Name="DeveloperApiButton"
                            Content="⚙️ KLUCZE API" 
                            Style="{StaticResource BrutalistButton}" 
                            Background="{StaticResource BrushPaperWhite}"
                            FontWeight="Bold" 
                            FontSize="11" 
                            Padding="10,5" 
                            Margin="0,0,6,0" 
                            ToolTip="Konfiguracja własnego Spotify Client ID i Secret dla zaawansowanych"
                            Click="DeveloperApi_Click" />

                    <Button x:Name="LogoutButton"
                            Content="🚪 WYLOGUJ" 
                            Style="{StaticResource BrutalistButton}" 
                            Background="{StaticResource BrushPaperWhite}"
                            FontWeight="Bold" 
                            FontSize="11" 
                            Padding="10,5" 
                            Visibility="Collapsed"
                            Click="Logout_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= ROW 1: SPLIT VIEW (PLAYLISTS & TRACKS) ================= -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="300" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" MinWidth="400" />
            </Grid.ColumnDefinitions>

            <!-- ================= LEFT: PLAYLISTS SELECTOR ================= -->
            <Border Grid.Column="0" Style="{StaticResource BrutalistCard}" Padding="10" Background="{StaticResource BrushPaperWhite}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Tabs & Search -->
                        <RowDefinition Height="*" />    <!-- Playlists List -->
                        <RowDefinition Height="Auto" /> <!-- Refresh & Info -->
                    </Grid.RowDefinitions>

                    <!-- Category Tabs & Search Bar -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="TabMyPlaylistsBtn"
                                    Grid.Column="0" 
                                    Content="📁 PLAYLISTY" 
                                    Style="{StaticResource GreenStartButton}" 
                                    FontWeight="Black" 
                                    FontSize="11" 
                                    Padding="6,4" 
                                    Margin="0,0,3,0" 
                                    Click="TabMyPlaylists_Click" />

                            <Button x:Name="TabLikedSongsBtn"
                                    Grid.Column="1" 
                                    Content="❤️ POLUBIONE" 
                                    Style="{StaticResource BrutalistButton}" 
                                    Background="{StaticResource BrushPaperWhite}"
                                    FontWeight="Black" 
                                    FontSize="11" 
                                    Padding="6,4" 
                                    Margin="3,0,0,0" 
                                    Click="TabLikedSongs_Click" />
                        </Grid>

                        <Grid>
                            <TextBox x:Name="PlaylistSearchTextBox" 
                                     Style="{StaticResource BrutalistTextBox}" 
                                     FontSize="11" 
                                     Padding="8,5" 
                                     KeyDown="PlaylistSearchTextBox_KeyDown" />
                            <TextBlock x:Name="SearchPlaceholder" 
                                       Text="🔍 Szukaj playlisty lub wklej link..." 
                                       Foreground="#888888" 
                                       FontWeight="SemiBold" 
                                       FontSize="11" 
                                       IsHitTestVisible="False" 
                                       Margin="10,6,0,0" />
                        </Grid>
                    </StackPanel>

                    <!-- Playlists ListBox -->
                    <Grid Grid.Row="1">
                        <ListBox x:Name="PlaylistsListBox" 
                                 BorderThickness="0" 
                                 Background="Transparent" 
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="PlaylistsListBox_SelectionChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,6" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemBorder" 
                                                        Style="{StaticResource BrutalistCard}" 
                                                        Background="{StaticResource BrushCardBg}" 
                                                        Padding="6" 
                                                        Cursor="Hand">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource BrushNeonYellow}" />
                                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource BrushBlackBorder}" />
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#FFF9DB" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:SpotifyPlaylistSummary}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Playlist Cover Thumbnail -->
                                        <Border Grid.Column="0" 
                                                Width="44" Height="44" 
                                                Background="#E0E0E0" 
                                                BorderBrush="{StaticResource BrushBlackBorder}" 
                                                BorderThickness="1.5" 
                                                CornerRadius="2" 
                                                Margin="0,0,8,0">
                                            <Image Source="{Binding ImageUrl}" Stretch="UniformToFill" />
                                        </Border>

                                        <!-- Playlist Info -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" 
                                                       FontWeight="Black" 
                                                       FontSize="11" 
                                                       Foreground="{StaticResource BrushBlackBorder}" 
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding OwnerName, StringFormat='Autor: {0}'}" 
                                                       FontSize="10" 
                                                       Foreground="#666666" 
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding TotalTracks, StringFormat='🎵 {0} utworów'}" 
                                                       FontWeight="Bold" 
                                                       FontSize="10" 
                                                       Foreground="{StaticResource BrushBlackBorder}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Empty State / Loading Overlay for Playlists -->
                        <Border x:Name="PlaylistsLoadingOverlay" Background="#E6FFFFFF" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="⏳" FontSize="28" HorizontalAlignment="Center" />
                                <TextBlock x:Name="PlaylistsLoadingText" Text="Wczytywanie playlist..." FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Bottom Refresh Button -->
                    <Grid Grid.Row="2" Margin="0,6,0,0">
                        <Button Content="🔄 ODŚWIEŻ LISTĘ" 
                                Style="{StaticResource BrutalistButton}" 
                                Background="{StaticResource BrushPaperWhite}" 
                                FontWeight="Bold" 
                                FontSize="10" 
                                Padding="8,4" 
                                HorizontalAlignment="Stretch" 
                                Click="RefreshPlaylists_Click" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" Background="Transparent" Cursor="SizeWE" />

            <!-- ================= RIGHT: TRACKS INSPECTOR ================= -->
            <Border Grid.Column="2" Style="{StaticResource BrutalistCard}" Padding="10" Background="{StaticResource BrushPaperWhite}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Selected Playlist Banner -->
                        <RowDefinition Height="Auto" /> <!-- Selection Controls Bar -->
                        <RowDefinition Height="*" />    <!-- Tracks DataGrid -->
                    </Grid.RowDefinitions>

                    <!-- Selected Playlist Banner Header -->
                    <Border Grid.Row="0" Style="{StaticResource BrutalistCard}" Margin="0,0,0,8" Padding="8" Background="{StaticResource BrushNeonYellow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="60" Height="60" BorderBrush="{StaticResource BrushBlackBorder}" BorderThickness="2" Background="#DDDDDD" CornerRadius="3" Margin="0,0,10,0">
                                <Image x:Name="SelectedCoverImage" Stretch="UniformToFill" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="SelectedPlaylistTitleText" Text="Wybierz playlistę z listy po lewej stronie" FontWeight="Black" FontSize="14" Foreground="{StaticResource BrushBlackBorder}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="SelectedPlaylistSubtitleText" Text="Kliknij dowolną pozycję, aby załadować listę utworów." FontSize="11" Foreground="#444444" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <Button Grid.Column="2" 
                                    x:Name="OpenInSpotifyBtn"
                                    Content="🌐 OTWÓRZ W SPOTIFY" 
                                    Style="{StaticResource BrutalistButton}" 
                                    Background="{StaticResource BrushPaperWhite}"
                                    FontWeight="Bold" 
                                    FontSize="10" 
                                    Padding="8,5" 
                                    VerticalAlignment="Center" 
                                    Click="OpenInSpotify_Click" />
                        </Grid>
                    </Border>

                    <!-- Selection Controls Bar -->
                    <Grid Grid.Row="1" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Content="☑️ ZAZNACZ WSZYSTKIE" 
                                Style="{StaticResource BrutalistButton}" 
                                Background="{StaticResource BrushPaperWhite}"
                                FontWeight="Bold" 
                                FontSize="10" 
                                Padding="8,4" 
                                Margin="0,0,6,0" 
                                Click="SelectAll_Click" />

                        <Button Grid.Column="1" 
                                Content="⬜ ODZNACZ WSZYSTKIE" 
                                Style="{StaticResource BrutalistButton}" 
                                Background="{StaticResource BrushPaperWhite}"
                                FontWeight="Bold" 
                                FontSize="10" 
                                Padding="8,4" 
                                Click="UnselectAll_Click" />

                        <TextBlock Grid.Column="2" 
                                   x:Name="TracksSelectionSummaryText" 
                                   Text="Utworów: 0 | Zaznaczono: 0" 
                                   FontWeight="Black" 
                                   FontSize="11" 
                                   Foreground="{StaticResource BrushBlackBorder}" 
                                   HorizontalAlignment="Right" 
                                   VerticalAlignment="Center" />
                    </Grid>

                    <!-- Tracks DataGrid -->
                    <Grid Grid.Row="2">
                        <DataGrid x:Name="TracksDataGrid" 
                                  AutoGenerateColumns="False" 
                                  CanUserAddRows="False" 
                                  CanUserDeleteRows="False" 
                                  SelectionMode="Single"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#E2DED4"
                                  BorderThickness="1.5"
                                  BorderBrush="{StaticResource BrushBlackBorder}"
                                  Background="{StaticResource BrushPaperWhite}"
                                  HeadersVisibility="Column"
                                  VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <!-- Checkbox Column -->
                                <DataGridTemplateColumn Width="40">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="☑" FontWeight="Black" HorizontalAlignment="Center" />
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type models:SpotifyTrackItem}">
                                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" 
                                                      HorizontalAlignment="Center" 
                                                      VerticalAlignment="Center" 
                                                      Click="TrackCheckbox_Click" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Index -->
                                <DataGridTextColumn Header="#" Binding="{Binding TrackNumber}" Width="35" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Black" />
                                            <Setter Property="Foreground" Value="#777777" />
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Title -->
                                <DataGridTextColumn Header="TYTUŁ UTWORU" Binding="{Binding Title}" Width="2*" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold" />
                                            <Setter Property="Foreground" Value="{StaticResource BrushBlackBorder}" />
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                            <Setter Property="Margin" Value="4,0,0,0" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Artist -->
                                <DataGridTextColumn Header="WYKONAWCA" Binding="{Binding Artist}" Width="1.5*" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="Foreground" Value="#333333" />
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                            <Setter Property="Margin" Value="4,0,0,0" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Album -->
                                <DataGridTextColumn Header="ALBUM" Binding="{Binding Album}" Width="1.5*" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#555555" />
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                            <Setter Property="Margin" Value="4,0,0,0" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Duration -->
                                <DataGridTextColumn Header="CZAS" Binding="{Binding DurationString}" Width="60" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="Foreground" Value="#666666" />
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Empty / Loading Overlay for Tracks -->
                        <Border x:Name="TracksLoadingOverlay" Background="#E6FFFFFF" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="⏳" FontSize="32" HorizontalAlignment="Center" />
                                <TextBlock x:Name="TracksLoadingText" Text="Wczytywanie utworów playlisty..." FontWeight="Black" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= ROW 2: STATUS & ACTION BAR ================= -->
        <Border Grid.Row="2" Style="{StaticResource BrutalistCard}" Padding="10" Background="{StaticResource BrushNeonYellow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="GlobalStatusText" Text="Wybierz utwory i kliknij 'DODAJ DO KOLEJKI', aby przesłać je do pobierania w ExportX." FontWeight="Bold" FontSize="11" Foreground="{StaticResource BrushBlackBorder}" />
                </StackPanel>

                <Button Grid.Column="1" 
                        x:Name="AddToQueueBtn"
                        Content="➕ DODAJ DO KOLEJKI EXPORTX" 
                        Style="{StaticResource GreenStartButton}" 
                        FontWeight="Black" 
                        FontSize="12" 
                        Padding="16,8" 
                        Margin="0,0,8,0" 
                        Click="AddToQueue_Click" />

                <Button Grid.Column="2" 
                        x:Name="AddAndStartBtn"
                        Content="▶ DODAJ I POBIERZ TERAZ" 
                        Style="{StaticResource CyanButton}" 
                        FontWeight="Black" 
                        FontSize="12" 
                        Padding="16,8" 
                        Click="AddAndStart_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
