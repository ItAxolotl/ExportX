<Window x:Class="ExportX.Views.SpotifyLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="🟢 LOGOWANIE DO SPOTIFY"
        Height="720" Width="940"
        MinHeight="550" MinWidth="750"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource NotebookGridPatternBrush}"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResizeWithGrip">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="*" />    <!-- WebView2 Web Browser -->
            <RowDefinition Height="Auto" /> <!-- Bottom Action Bar -->
        </Grid.RowDefinitions>

        <!-- Red margin stripe decoration on left -->
        <Border Grid.RowSpan="3" 
                Width="3" 
                HorizontalAlignment="Left" 
                Background="{StaticResource BrushNotebookRedMargin}" 
                Margin="-8,-16,0,-16" />

        <!-- ================= HEADER CARD ================= -->
        <Border Grid.Row="0" Style="{StaticResource BrutalistCard}" Margin="0,0,0,10" Background="{StaticResource BrushNeonLime}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="🟢" FontSize="26" Margin="0,0,10,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="LOGOWANIE DO KONTA SPOTIFY" 
                               FontFamily="Segoe UI" 
                               FontWeight="Black" 
                               FontSize="15" 
                               Foreground="{StaticResource BrushBlackBorder}" />
                    <TextBlock Text="Zaloguj się w oknie poniżej LUB kliknij przycisk obok, aby pobrać sesję bezpośrednio ze swojej przeglądarki bez wpisywania haseł!" 
                               FontSize="11" 
                               FontWeight="SemiBold" 
                               Foreground="#222222" 
                               TextWrapping="Wrap" />
                </StackPanel>

                <Button Grid.Column="2" 
                        Content="✔ ZATWIERDŹ ZALOGOWANIE" 
                        Style="{StaticResource GreenStartButton}" 
                        FontWeight="Black"
                        FontSize="11" 
                        Padding="12,6" 
                        Margin="10,0,6,0"
                        VerticalAlignment="Center"
                        ToolTip="Kliknij, jeśli jesteś już zalogowany w oknie poniżej, aby natychmiast zapisać sesję"
                        Click="SaveSessionFromWebView_Click" />

                <Border Grid.Column="3" x:Name="StatusBadge" Style="{StaticResource StickyNoteTag}" Background="{StaticResource BrushNeonYellow}" Padding="8,4" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusBadgeText" Text="OCZEKIWANIE NA LOGOWANIE" FontWeight="Black" FontSize="10" Foreground="{StaticResource BrushBlackBorder}" />
                </Border>
            </Grid>
        </Border>

        <!-- ================= MAIN WEBVIEW BROWSER ================= -->
        <Border Grid.Row="1" Style="{StaticResource BrutalistCard}" Margin="0,0,0,10" Padding="2" Background="{StaticResource BrushPaperWhite}">
            <Grid>
                <wv2:WebView2 x:Name="LoginWebView" />

                <!-- Loading / Fallback Overlay -->
                <Border x:Name="LoadingOverlay" Background="#F6F4ED" Visibility="Visible">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="540">
                        <TextBlock x:Name="OverlayTitle" Text="⏳ Inicjalizacja logowania Spotify..." FontWeight="Black" FontSize="14" Foreground="{StaticResource BrushBlackBorder}" HorizontalAlignment="Center" />
                        <TextBlock x:Name="OverlaySubtitle" Text="Proszę czekać, przygotowujemy bezpieczne środowisko logowania..." FontSize="11" Foreground="#666666" Margin="0,4,0,12" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />

                        <!-- Fallback panel if WebView2 runtime is missing -->
                        <StackPanel x:Name="FallbackPanel" Visibility="Collapsed">
                            <TextBlock Text="Możesz otworzyć stronę w zewnętrznej przeglądarce i pobrać sesję jednym kliknięciem:" FontSize="11" FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap" TextAlignment="Center" />
                            
                            <Button Content="🌐 OTWÓRZ SPOTIFY W PRZEGLĄDARCE" 
                                    Style="{StaticResource CyanButton}" 
                                    FontWeight="Black" 
                                    FontSize="11" 
                                    Padding="14,8" 
                                    Margin="0,0,0,8"
                                    Click="OpenInExternalBrowser_Click" />

                            <Button Content="⚡ POBIERZ SESJĘ Z PRZEGLĄDARKI" 
                                    Style="{StaticResource GreenStartButton}" 
                                    FontWeight="Black" 
                                    FontSize="11" 
                                    Padding="14,8" 
                                    Margin="0,0,0,8"
                                    Click="ExtractFromExternalBrowser_Click" />

                            <Button Content="📥 IMPORTUJ PLIK COOKIES.TXT" 
                                    Style="{StaticResource BrutalistButton}" 
                                    Background="{StaticResource BrushPaperWhite}"
                                    FontWeight="Bold" 
                                    FontSize="11" 
                                    Padding="14,8" 
                                    Click="ImportCookiesFile_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ================= ROW 2: BOTTOM ACTION BAR ================= -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusNote" 
                       Grid.Column="0" 
                       Text="💡 Po zalogowaniu ExportX automatycznie wykryje Twoją sesję i zamknie to okno." 
                       FontSize="11" 
                       FontWeight="Bold" 
                       Foreground="#555555" 
                       VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="⚡ Z PRZEGLĄDARKI" 
                        Style="{StaticResource CyanButton}" 
                        FontWeight="Bold" 
                        FontSize="11" 
                        Padding="10,6" 
                        Margin="0,0,6,0"
                        Click="ExtractFromExternalBrowser_Click" />

                <Button Content="🌐 OTWÓRZ W PRZEGLĄDARCE" 
                        Style="{StaticResource BrutalistButton}" 
                        Background="{StaticResource BrushPaperWhite}" 
                        FontWeight="Bold" 
                        FontSize="11" 
                        Padding="10,6" 
                        Margin="0,0,6,0"
                        Click="OpenInExternalBrowser_Click" />

                <Button Content="📥 IMPORTUJ COOKIES.TXT" 
                        Style="{StaticResource BrutalistButton}" 
                        Background="{StaticResource BrushPaperWhite}" 
                        FontWeight="Bold" 
                        FontSize="11" 
                        Padding="10,6" 
                        Margin="0,0,6,0"
                        Click="ImportCookiesFile_Click" />

                <Button Content="🍪 WKLEJ SP_DC" 
                        Style="{StaticResource BrutalistButton}" 
                        Background="{StaticResource BrushPaperWhite}" 
                        FontWeight="Bold" 
                        FontSize="11" 
                        Padding="10,6" 
                        Margin="0,0,6,0"
                        Click="PasteSpDc_Click" />

                <Button Content="🔄 ODŚWIEŻ" 
                        Style="{StaticResource BrutalistButton}" 
                        Background="{StaticResource BrushPaperWhite}" 
                        FontWeight="Bold" 
                        FontSize="11" 
                        Padding="10,6" 
                        Margin="0,0,6,0"
                        Click="RefreshPage_Click" />

                <Button Content="❌ ANULUJ" 
                        Style="{StaticResource BrutalistButton}" 
                        Background="{StaticResource BrushPaperWhite}" 
                        FontWeight="Bold" 
                        FontSize="11" 
                        Padding="12,6" 
                        Click="Cancel_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
