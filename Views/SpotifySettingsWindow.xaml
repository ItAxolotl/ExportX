<Window x:Class="ExportX.Views.SpotifySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🟢 SPOTIFY API — OBSŁUGA PLAYLIST 500+ UTWORÓW"
        Height="540" Width="780"
        MinHeight="480" MinWidth="680"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource NotebookGridPatternBrush}"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResizeWithGrip">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="*" />    <!-- Content & Fields -->
            <RowDefinition Height="Auto" /> <!-- Action buttons -->
        </Grid.RowDefinitions>

        <!-- Red margin stripe decoration on left -->
        <Border Grid.RowSpan="3" 
                Width="3" 
                HorizontalAlignment="Left" 
                Background="{StaticResource BrushNotebookRedMargin}" 
                Margin="-10,-18,0,-18" />

        <!-- ================= HEADER CARD ================= -->
        <Border Grid.Row="0" Style="{StaticResource BrutalistCard}" Margin="0,0,0,14" Background="{StaticResource BrushNeonLime}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="🟢" FontSize="26" Margin="0,0,10,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="SPOTIFY DEVELOPER API (500+ UTWORÓW)" 
                               FontFamily="Segoe UI" 
                               FontWeight="Black" 
                               FontSize="14" 
                               Foreground="{StaticResource BrushBlackBorder}" />
                    <TextBlock Text="Darmowy klucz Spotify API pozwala wczytywać całe gigantyczne playlisty i albumy bez limitu 100 utworów!" 
                               FontSize="11" 
                               FontWeight="SemiBold" 
                               Foreground="#222222" 
                               TextWrapping="Wrap" />
                </StackPanel>

                <Button Grid.Column="2" 
                        Content="🌐 OTWÓRZ SPOTIFY DASHBOARD" 
                        Style="{StaticResource BrutalistButton}" 
                        Background="{StaticResource BrushPaperWhite}"
                        FontWeight="Black"
                        FontSize="11"
                        Padding="10,6"
                        VerticalAlignment="Center"
                        Click="OpenSpotifyDashboard_Click" />
            </Grid>
        </Border>

        <!-- ================= MAIN FIELDS CARD ================= -->
        <Border Grid.Row="1" Style="{StaticResource BrutalistCard}" Margin="0,0,0,14" Padding="14" Background="{StaticResource BrushPaperWhite}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Info Box -->
                    <Border Background="#FEF9C3" BorderBrush="{StaticResource BrushBlackBorder}" BorderThickness="1.5" Padding="10" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="💡 JAK TO DZIAŁA?" FontWeight="Black" FontSize="11" Foreground="{StaticResource BrushBlackBorder}" Margin="0,0,0,4" />
                            <TextBlock Text="1. Zaloguj się na developer.spotify.com i kliknij 'Create App' (zajmuje to 15 sekund)." FontSize="11" FontWeight="SemiBold" Foreground="#333333" TextWrapping="Wrap" />
                            <TextBlock Text="2. Jako 'App name' wpisz cokolwiek (np. ExportX), jako 'Redirect URI' wpisz http://localhost:8080." FontSize="11" FontWeight="SemiBold" Foreground="#333333" TextWrapping="Wrap" Margin="0,2,0,0" />
                            <TextBlock Text="3. Wklej poniżej swój Client ID i Client Secret i kliknij 'TESTUJ POŁĄCZENIE'." FontSize="11" FontWeight="SemiBold" Foreground="#333333" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Client ID -->
                    <TextBlock Text="SPOTIFY CLIENT ID:" FontWeight="Black" FontSize="11" Margin="0,0,0,4" Foreground="{StaticResource BrushBlackBorder}" />
                    <TextBox x:Name="ClientIdTextBox" 
                             Style="{StaticResource BrutalistTextBox}" 
                             FontFamily="Consolas" 
                             FontSize="12" 
                             Padding="8,6" 
                             Margin="0,0,0,12" />

                    <!-- Client Secret -->
                    <TextBlock Text="SPOTIFY CLIENT SECRET:" FontWeight="Black" FontSize="11" Margin="0,0,0,4" Foreground="{StaticResource BrushBlackBorder}" />
                    <TextBox x:Name="ClientSecretTextBox" 
                             Style="{StaticResource BrutalistTextBox}" 
                             FontFamily="Consolas" 
                             FontSize="12" 
                             Padding="8,6" 
                             Margin="0,0,0,14" />

                    <!-- Status Result -->
                    <Border x:Name="StatusResultBorder" 
                            BorderBrush="{StaticResource BrushBlackBorder}" 
                            BorderThickness="2" 
                            Padding="10,8" 
                            Background="#F3F4F6" 
                            Margin="0,0,0,10">
                        <TextBlock x:Name="StatusResultText" 
                                   Text="Status: Nie przetestowano. Wprowadź klucze i kliknij '⚡ TESTUJ POŁĄCZENIE'." 
                                   FontWeight="Bold" 
                                   FontSize="11" 
                                   Foreground="#555555" 
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ================= BOTTOM ACTION BAR ================= -->
        <Border Grid.Row="2" Style="{StaticResource BrutalistCard}" Padding="10,8" Background="{StaticResource BrushPaperWhite}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" 
                        Content="⚡ TESTUJ POŁĄCZENIE" 
                        Style="{StaticResource CyanButton}" 
                        FontWeight="Black" 
                        FontSize="11" 
                        Padding="12,6" 
                        Click="TestConnection_Click" />

                <Button Grid.Column="2" 
                        Content="🗑️ USUŃ KLUCZE" 
                        Style="{StaticResource BrutalistButton}" 
                        Background="{StaticResource BrushNeonPink}"
                        FontSize="11" 
                        Padding="10,6" 
                        Margin="0,0,6,0" 
                        Click="ClearKeys_Click" />

                <Button Grid.Column="3" 
                        Content="❌ ANULUJ" 
                        Style="{StaticResource BrutalistButton}" 
                        Background="{StaticResource BrushPaperWhite}"
                        FontSize="11" 
                        Padding="10,6" 
                        Margin="0,0,6,0" 
                        Click="Cancel_Click" />

                <Button Grid.Column="4" 
                        Content="💾 ZAPISZ I ZASTOSUJ" 
                        Style="{StaticResource GreenStartButton}" 
                        FontWeight="Black" 
                        FontSize="11" 
                        Padding="14,6" 
                        Click="SaveAndClose_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
