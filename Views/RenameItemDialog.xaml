<Window x:Class="ExportX.Views.RenameItemDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="✏️ ZMIANA NAZWY PLIKU DOCELOWEGO"
        Height="420" Width="640"
        MinHeight="360" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource NotebookGridPatternBrush}"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="*" />    <!-- Content & Input -->
            <RowDefinition Height="Auto" /> <!-- Action buttons -->
        </Grid.RowDefinitions>

        <!-- Red margin stripe decoration on left -->
        <Border Grid.RowSpan="3" 
                Width="3" 
                HorizontalAlignment="Left" 
                Background="{StaticResource BrushNotebookRedMargin}" 
                Margin="-8,-16,0,-16" />

        <!-- ================= HEADER CARD ================= -->
        <Border Grid.Row="0" Style="{StaticResource BrutalistCard}" Margin="0,0,0,12" Background="{StaticResource BrushNeonYellow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="✏️" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="WŁASNA NAZWA PLIKU" 
                               FontFamily="Segoe UI" 
                               FontWeight="Black" 
                               FontSize="14" 
                               Foreground="{StaticResource BrushBlackBorder}" />
                    <TextBlock Text="Zmień nazwę pliku na dysku. Tagi metadanych ID3 (Tytuł i Autor) pozostaną nienaruszone!" 
                               FontSize="11" 
                               FontWeight="SemiBold" 
                               Foreground="#333333" 
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= MAIN CONTENT CARD ================= -->
        <Border Grid.Row="1" Style="{StaticResource BrutalistCard}" Margin="0,0,0,12" Padding="12" Background="{StaticResource BrushPaperWhite}">
            <StackPanel>
                <TextBlock Text="UTWÓR:" FontWeight="Black" FontSize="10" Foreground="#666666" Margin="0,0,0,2" />
                <TextBlock x:Name="TrackInfoText" Text="Wykonawca - Tytuł" FontWeight="Bold" FontSize="12" Foreground="{StaticResource BrushBlackBorder}" Margin="0,0,0,10" TextTrimming="CharacterEllipsis" />

                <TextBlock Text="NAZWA PLIKU (BEZ ROZSZERZENIA):" FontWeight="Black" FontSize="11" Margin="0,0,0,4" Foreground="{StaticResource BrushBlackBorder}" />
                <TextBox x:Name="FileNameTextBox" 
                         Style="{StaticResource BrutalistTextBox}" 
                         FontSize="12" 
                         Padding="8,6" 
                         Margin="0,0,0,8" 
                         KeyDown="FileNameTextBox_KeyDown" />

                <!-- Quick Preset Buttons -->
                <TextBlock Text="SZYBKIE SZABLONY:" FontWeight="Black" FontSize="10" Foreground="#666666" Margin="0,0,0,4" />
                <WrapPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="Tytuł" 
                            Style="{StaticResource BrutalistButton}" 
                            Background="{StaticResource BrushPaperWhite}"
                            FontSize="10" 
                            Padding="6,3" 
                            Margin="0,0,4,4" 
                            Click="PresetTitle_Click" />

                    <Button Content="Wykonawca - Tytuł" 
                            Style="{StaticResource BrutalistButton}" 
                            Background="{StaticResource BrushPaperWhite}"
                            FontSize="10" 
                            Padding="6,3" 
                            Margin="0,0,4,4" 
                            Click="PresetArtistTitle_Click" />

                    <Button Content="Tytuł - Wykonawca" 
                            Style="{StaticResource BrutalistButton}" 
                            Background="{StaticResource BrushPaperWhite}"
                            FontSize="10" 
                            Padding="6,3" 
                            Margin="0,0,4,4" 
                            Click="PresetTitleArtist_Click" />

                    <Button Content="Domyślna (Tytuł [ID])" 
                            Style="{StaticResource BrutalistButton}" 
                            Background="{StaticResource BrushPaperWhite}"
                            FontSize="10" 
                            Padding="6,3" 
                            Margin="0,0,4,4" 
                            Click="PresetDefault_Click" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- ================= BOTTOM ACTION BAR ================= -->
        <Border Grid.Row="2" Style="{StaticResource BrutalistCard}" Padding="10,8" Background="{StaticResource BrushPaperWhite}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" 
                        Content="🔄 PRZYWRÓĆ DOMYŚLNĄ" 
                        Style="{StaticResource BrutalistButton}" 
                        Background="{StaticResource BrushPaperWhite}" 
                        FontSize="11" 
                        Padding="10,6" 
                        Click="ResetDefault_Click" />

                <Button Grid.Column="2" 
                        Content="❌ ANULUJ" 
                        Style="{StaticResource BrutalistButton}" 
                        Background="{StaticResource BrushPaperWhite}" 
                        FontSize="11" 
                        Padding="10,6" 
                        Margin="0,0,6,0" 
                        Click="Cancel_Click" />

                <Button Grid.Column="3" 
                        Content="💾 ZATWIERDŹ" 
                        Style="{StaticResource GreenStartButton}" 
                        FontWeight="Black" 
                        FontSize="11" 
                        Padding="14,6" 
                        Click="Save_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
